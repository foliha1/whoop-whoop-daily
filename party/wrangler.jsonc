{
  // Together table server. One Durable Object (a tiny always-on server) per Table.
  // Deployed by .github/workflows/deploy-tables.yml on every push to main that touches party/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whoop-whoop-tables",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The rules come from the app (../src). Its art file is swapped for a stub.
  "alias": { "@/lib/assetUrls": "./src/assetUrlsStub.ts" },
  "durable_objects": {
    "bindings": [{ "name": "Table", "class_name": "Table" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }],
  // Public values only (the same ones every phone has). Seats are checked and
  // results saved through public database functions; no secret lives here.
  "vars": {
    "TABLE_AUTH": "supabase",
    "SUPABASE_URL": "https://ykbsctucsvmdaliersjm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable__rxenqoPJaZfKRNoW17Jdg_4F5kRhEr"
  },
  "observability": { "enabled": true }
}
